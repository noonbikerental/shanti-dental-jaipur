            </div>
          </div>

          <div class="rounded-2xl bg-white border border-slate-200 overflow-hidden">
            <button type="button" class="faq-trigger w-full min-h-[56px] px-5 py-4 text-left flex items-center justify-between gap-4 font-semibold text-[#1F2A30]" aria-expanded="false" aria-controls="home-faq-4">
